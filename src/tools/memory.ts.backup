import { promises as fs } from 'node:fs';
import path from 'node:path';
import { ToolDefinition } from './types.js';

const memoryFile = path.resolve('data/memory.json');

type Memory = {
  id: number;
  text: string;
  category: string;
  importance: 'low' | 'normal' | 'high';
  created_at: string;
  updated_at: string;
};

async function loadMemories(): Promise<Memory[]> {
  try {
    const data = await fs.readFile(memoryFile, 'utf8');
    const parsed = JSON.parse(data);

    if (!Array.isArray(parsed)) {
      return [];
    }

    return parsed.map((memory: any) => ({
      id: Number(memory.id ?? Date.now()),
      text: String(memory.text ?? ''),
      category: String(memory.category ?? 'general'),
      importance:
        memory.importance === 'high' ||
        memory.importance === 'low'
          ? memory.importance
          : 'normal',
      created_at:
        String(memory.created_at ?? new Date().toISOString()),
      updated_at:
        String(
          memory.updated_at ??
          memory.created_at ??
          new Date().toISOString()
        )
    }));
  } catch {
    return [];
  }
}

async function saveMemories(memories: Memory[]) {
  await fs.mkdir(path.dirname(memoryFile), { recursive: true });

  await fs.writeFile(
    memoryFile,
    JSON.stringify(memories, null, 2),
    'utf8'
  );
}

export const memoryTool: ToolDefinition = {
  name: 'remember',
  description:
    'Save useful information to JARVIS local memory. Use this for durable facts, preferences, project details, or instructions that will be useful in future conversations.',

  permission: 'write_low_risk',

  parameters: {
    type: 'object',
    properties: {
      text: {
        type: 'string',
        description: 'The information to remember.'
      },
      category: {
        type: 'string',
        description:
          'Memory category such as preference, project, fact, instruction, or general.'
      },
      importance: {
        type: 'string',
        enum: ['low', 'normal', 'high'],
        description:
          'How important this memory is for future conversations.'
      }
    },
    required: ['text'],
    additionalProperties: false
  },

  async execute(args) {
    const text = String(args.text ?? '').trim();

    if (!text) {
      throw new Error('Memory text is required');
    }

    const category =
      String(args.category ?? 'general').trim().toLowerCase() ||
      'general';

    const importance =
      args.importance === 'high' || args.importance === 'low'
        ? args.importance
        : 'normal';

    const memories = await loadMemories();

    const normalizedText = text.toLowerCase();

    const duplicate = memories.find(
      memory =>
        memory.text.trim().toLowerCase() === normalizedText
    );

    if (duplicate) {
      duplicate.updated_at = new Date().toISOString();
      duplicate.category = category;
      duplicate.importance = importance;

      await saveMemories(memories);

      return {
        success: true,
        duplicate: true,
        memory: duplicate
      };
    }

    const now = new Date().toISOString();

    const memory: Memory = {
      id: Date.now(),
      text,
      category,
      importance,
      created_at: now,
      updated_at: now
    };

    memories.push(memory);

    await saveMemories(memories);

    return {
      success: true,
      duplicate: false,
      memory
    };
  }
};

export const recallTool: ToolDefinition = {
  name: 'recall',
  description:
    'Search JARVIS local memory for previously saved information. Use this when a user asks about something JARVIS may have been told before.',

  permission: 'read_only',

  parameters: {
    type: 'object',
    properties: {
      query: {
        type: 'string',
        description: 'What information to look for in memory.'
      },
      category: {
        type: 'string',
        description:
          'Optional category filter such as preference, project, fact, instruction, or general.'
      }
    },
    required: ['query'],
    additionalProperties: false
  },

  async execute(args) {
    const query =
      String(args.query ?? '').trim().toLowerCase();

    if (!query) {
      throw new Error('Memory query is required');
    }

    const category =
      String(args.category ?? '').trim().toLowerCase();

    const memories = await loadMemories();

    const words = query
      .split(/\s+/)
      .filter(word => word.length >= 2);

    const scored = memories
      .filter(memory => {
        if (!category) return true;
        return memory.category.toLowerCase() === category;
      })
      .map(memory => {
        const text = memory.text.toLowerCase();
        const memoryCategory = memory.category.toLowerCase();

        let score = 0;

        if (text.includes(query)) {
          score += 10;
        }

        for (const word of words) {
          if (text.includes(word)) {
            score += 1;
          }

          if (memoryCategory.includes(word)) {
            score += 2;
          }
        }

        if (memory.importance === 'high') {
          score += 1;
        }

        return {
          memory,
          score
        };
      })
      .filter(item => item.score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }

        return (
          new Date(b.memory.updated_at).getTime() -
          new Date(a.memory.updated_at).getTime()
        );
      });

    return {
      query,
      count: scored.length,
      memories: scored
        .slice(0, 10)
        .map(item => item.memory)
    };
  }
};

export const listMemoriesTool: ToolDefinition = {
  name: 'list_memories',
  description:
    'List saved JARVIS memories. Use this when the user asks what JARVIS remembers.',

  permission: 'read_only',

  parameters: {
    type: 'object',
    properties: {
      category: {
        type: 'string',
        description:
          'Optional category filter.'
      }
    },
    additionalProperties: false
  },

  async execute(args) {
    const category =
      String(args.category ?? '').trim().toLowerCase();

    const memories = await loadMemories();

    const filtered = category
      ? memories.filter(
          memory =>
            memory.category.toLowerCase() === category
        )
      : memories;

    return {
      count: filtered.length,
      memories: filtered.slice(-50)
    };
  }
};

export const forgetMemoryTool: ToolDefinition = {
  name: 'forget_memory',
  description:
    'Delete a specific memory by its numeric memory ID. Only use this when the user explicitly asks JARVIS to forget something.',

  permission: 'write_low_risk',

  parameters: {
    type: 'object',
    properties: {
      id: {
        type: 'number',
        description: 'The numeric ID of the memory to delete.'
      }
    },
    required: ['id'],
    additionalProperties: false
  },

  async execute(args) {
    const id = Number(args.id);

    if (!Number.isFinite(id)) {
      throw new Error('A valid memory ID is required');
    }

    const memories = await loadMemories();

    const index = memories.findIndex(
      memory => memory.id === id
    );

    if (index === -1) {
      return {
        success: false,
        message: `Memory ${id} was not found.`
      };
    }

    const [deleted] = memories.splice(index, 1);

    await saveMemories(memories);

    return {
      success: true,
      deleted
    };
  }
};
