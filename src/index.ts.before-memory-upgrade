import 'dotenv/config';
import Fastify from 'fastify';
import cors from '@fastify/cors';
import { promises as fs } from 'node:fs';
import path from 'node:path';

import { askOpenRouter } from './orchestrator/openrouter.js';
import { executeToolCall } from './executor.js';

const historyFile = path.resolve('data/chat_history.json');

type Message = {
  role: string;
  content?: string | null;
  tool_calls?: any[];
  tool_call_id?: string;
  name?: string;
};

async function loadHistory(): Promise<Message[]> {
  try {
    const data = await fs.readFile(historyFile, 'utf8');
    return JSON.parse(data) as Message[];
  } catch {
    return [];
  }
}

async function saveHistory(messages: Message[]) {
  await fs.mkdir(path.dirname(historyFile), { recursive: true });

  await fs.writeFile(
    historyFile,
    JSON.stringify(messages, null, 2),
    'utf8'
  );
}

async function main() {
  const app = Fastify({ logger: true });

  await app.register(cors, { origin: true });

  app.get('/', async () => ({
    name: 'JARVIS',
    status: 'online',
    version: '1.0.0'
  }));

  app.get('/health', async () => ({
    status: 'ok'
  }));

  app.post('/clear-history', async (request, reply) => {
    try {
      await fs.mkdir(path.dirname(historyFile), { recursive: true });

      await fs.writeFile(historyFile, '[]', 'utf8');

      return {
        success: true,
        message: 'Conversation history cleared.'
      };
    } catch (error) {
      request.log.error(error);

      return reply.code(500).send({
        error: 'Failed to clear conversation history'
      });
    }
  });

  app.post('/chat', async (request, reply) => {
    const body = request.body as { message?: string };

    if (!body?.message || typeof body.message !== 'string') {
      return reply.code(400).send({
        error: 'message is required'
      });
    }

    try {
      const history = await loadHistory();

      const messages: Message[] = [
        {
          role: 'system',
          content:
            'You are JARVIS, a helpful personal AI assistant. Use available tools whenever they are useful. Fresh tool results are authoritative and must override older conversation history or remembered information. Never guess current, changing, or real-world information when a tool can provide it. For current time or date, always use get_current_time. For weather, use get_weather. For up-to-date information, use web_search. After receiving a tool result, base your answer on that result rather than older messages.'
        },
        ...history.slice(-20),
        {
          role: 'user',
          content: body.message
        }
      ];

      let response = await askOpenRouter(messages);

      // JARVIS agent loop:
      // Keep allowing the model to call tools until it produces
      // a normal final answer.
      const MAX_TOOL_ROUNDS = 8;

      for (let round = 0; round < MAX_TOOL_ROUNDS; round++) {
        if (!response.tool_calls?.length) {
          messages.push(response);

          await saveHistory(
            messages.filter(message => message.role !== 'system')
          );

          return { response };
        }

        messages.push({
          role: 'assistant',
          content: response.content ?? null,
          tool_calls: response.tool_calls
        });

        for (const toolCall of response.tool_calls) {
          try {
            const toolResult = await executeToolCall(toolCall);

            messages.push({
              role: 'tool',
              content: toolResult.content,
              tool_call_id: toolResult.tool_call_id,
              name: toolResult.name
            });
          } catch (error) {
            const errorMessage =
              error instanceof Error
                ? error.message
                : String(error);

            request.log.error({
              tool: toolCall.function.name,
              error: errorMessage
            }, 'Tool execution failed');

            messages.push({
              role: 'tool',
              content: JSON.stringify({
                success: false,
                error: errorMessage,
                message:
                  'The tool failed. Do not pretend it succeeded. ' +
                  'Decide whether to retry, use another tool, or explain the limitation.'
              }),
              tool_call_id: toolCall.id,
              name: toolCall.function.name
            });
          }
        }

        // Ask the model what to do next after receiving the tool results.
        response = await askOpenRouter(messages);
      }

      throw new Error(
        `JARVIS exceeded maximum tool rounds (${MAX_TOOL_ROUNDS})`
      );

    } catch (error) {
      request.log.error(error);

      return reply.code(500).send({
        error: 'JARVIS AI request failed'
      });
    }
  });

  const port = Number(process.env.PORT || 3000);
  const host = process.env.HOST || '0.0.0.0';

  await app.listen({ port, host });

  console.log(`JARVIS running on http://${host}:${port}`);
}

main().catch((error) => {
  console.error('Failed to start JARVIS:', error);
  process.exit(1);
});
